@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager
@inject IRepository<Cart> CartRepository
@{
    Layout = null;

    var cartCount = 0;
    if (User.Identity is not null && User.Identity.IsAuthenticated)
    {
        var currentUser = await UserManager.GetUserAsync(User);
        if (currentUser is not null)
            cartCount = CartRepository.Get(e => e.ApplicationUserId == currentUser.Id).Count();
    }
}
<!DOCTYPE html>
<html data-bs-theme="light" lang="en-US">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>CinemaApp | @ViewData["Title"]</title>

    <script src="/assets/js/config.js"></script>

    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,500,600,700%7cPoppins:300,400,500,600,700,800,900&amp;display=swap" rel="stylesheet">
    <link href="/assets/css/theme.css" rel="stylesheet" id="style-default">
</head>

<body>
    <nav class="navbar navbar-light navbar-expand-lg py-3 border-bottom">
        <div class="container">
            <a class="navbar-brand" href="/Customer/Home/Index">
                <div class="d-flex align-items-center">
                    <img class="me-2" src="/assets/img/icons/spot-illustrations/falcon.png" alt="" width="35" />
                    <span class="font-sans-serif text-primary fs-4">CinemaApp</span>
                </div>
            </a>

            <div class="d-flex align-items-center ms-auto gap-3">
                @if (User.Identity is not null && User.Identity.IsAuthenticated)
                {
                    <a href="/Customer/Favorite/Index" class="nav-link" title="Favorites"><span class="fas fa-heart"></span></a>
                    <a href="/Customer/Order/Index" class="nav-link" title="My Bookings"><span class="fas fa-ticket-alt"></span></a>
                    <a href="/Customer/Cart/Index" class="nav-link position-relative" title="Cart">
                        <span class="fas fa-shopping-cart"></span>
                        @if (cartCount > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:0.6rem;">@cartCount</span>
                        }
                    </a>
                }

                <div class="dropdown theme-control-dropdown">
                    <a class="nav-link d-flex align-items-center dropdown-toggle fa-icon-wait fs-9 pe-1 py-0" href="#" role="button" id="themeSwitchDropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <span class="fas fa-sun fs-7" data-fa-transform="shrink-2" data-theme-dropdown-toggle-icon="light"></span>
                        <span class="fas fa-moon fs-7" data-fa-transform="shrink-3" data-theme-dropdown-toggle-icon="dark"></span>
                        <span class="fas fa-adjust fs-7" data-fa-transform="shrink-2" data-theme-dropdown-toggle-icon="auto"></span>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end dropdown-caret border py-0 mt-3" aria-labelledby="themeSwitchDropdown">
                        <div class="bg-white dark__bg-1000 rounded-2 py-2">
                            <button class="dropdown-item d-flex align-items-center gap-2" type="button" value="light" data-theme-control="theme"><span class="fas fa-sun"></span>Light<span class="fas fa-check dropdown-check-icon ms-auto text-600"></span></button>
                            <button class="dropdown-item d-flex align-items-center gap-2" type="button" value="dark" data-theme-control="theme"><span class="fas fa-moon"></span>Dark<span class="fas fa-check dropdown-check-icon ms-auto text-600"></span></button>
                            <button class="dropdown-item d-flex align-items-center gap-2" type="button" value="auto" data-theme-control="theme"><span class="fas fa-adjust"></span>Auto<span class="fas fa-check dropdown-check-icon ms-auto text-600"></span></button>
                        </div>
                    </div>
                </div>

                @if (User.Identity is not null && User.Identity.IsAuthenticated)
                {
                    @if (User.IsInRole(RoleConstants.SUPER_ADMIN) || User.IsInRole(RoleConstants.ADMIN) || User.IsInRole(RoleConstants.EMPLOYEE))
                    {
                        <a href="/Admin/Home/Index" class="btn btn-falcon-default btn-sm">Dashboard</a>
                    }
                    <a asp-area="Identity" asp-controller="Account" asp-action="Logout" class="btn btn-falcon-default btn-sm">Logout</a>
                }
                else
                {
                    <a asp-area="Identity" asp-controller="Account" asp-action="Login" class="btn btn-falcon-default btn-sm">Login</a>
                }
            </div>
        </div>
    </nav>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="border-top py-3 mt-5 text-center fs-10 text-muted">
        &copy; @DateTime.Now.Year CinemaApp
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <link href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="/vendors/popper/popper.min.js"></script>
    <script src="/vendors/bootstrap/bootstrap.min.js"></script>
    <script src="/vendors/fontawesome/all.min.js"></script>
    <script>
        (function () {
            var STORAGE_KEY = 'theme';

            function applyTheme(theme) {
                var resolved = theme;
                if (theme === 'auto') {
                    resolved = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                }
                document.documentElement.setAttribute('data-bs-theme', resolved);

                document.querySelectorAll('[data-theme-dropdown-toggle-icon]').forEach(function (el) {
                    el.classList.toggle('d-none', el.getAttribute('data-theme-dropdown-toggle-icon') !== theme);
                });
                document.querySelectorAll('[data-theme-control="theme"]').forEach(function (btn) {
                    btn.classList.toggle('active', btn.getAttribute('value') === theme);
                });
            }

            applyTheme(localStorage.getItem(STORAGE_KEY) || 'light');

            document.querySelectorAll('[data-theme-control="theme"]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var value = btn.getAttribute('value');
                    localStorage.setItem(STORAGE_KEY, value);
                    applyTheme(value);
                });
            });
        })();
    </script>
    @RenderSection("Scripts", false)
    @RenderSection("Notification", false)
</body>

</html>
