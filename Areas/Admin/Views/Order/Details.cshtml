@model IEnumerable<OrderItem>
@{
    var order = (Order)ViewData["Order"]!;
}

<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex flex-between-center">
                <div>
                    <h5 class="mb-0">Order #@order.Id &mdash; @order.ApplicationUser.FirstName @order.ApplicationUser.LastName</h5>
                    <p class="fs-10 text-muted mb-0">
                        @order.ApplicationUser.Email &middot;
                        @(order.PaymentMethod == PaymentMethod.Cash ? "Cash" : "Online") &middot;
                        @if (order.PaymentStatus == PaymentStatus.Succussed)
                        {
                            <span>Paid @order.PaymentDate?.ToString("dd MMM yyyy, hh:mm tt")</span>
                        }
                        else
                        {
                            <span class="text-warning">Payment @order.PaymentStatus</span>
                        }
                    </p>
                </div>

                @if (order.PaymentMethod == PaymentMethod.Cash && order.PaymentStatus != PaymentStatus.Succussed)
                {
                    <form asp-action="MarkAsPaid" asp-route-id="@order.Id" method="post">
                        <button type="submit" class="btn btn-sm btn-success">
                            <span class="fas fa-check me-1"></span> Mark as Paid (Cash Received)
                        </button>
                    </form>
                }
            </div>
            <div class="card-body border-top">
                <table class="table table-sm fs-9 mb-0">
                    <thead class="bg-body-tertiary">
                        <tr>
                            <th>Movie</th>
                            <th>Seat</th>
                            <th>Showtime</th>
                            <th>Price</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Movie.Name</td>
                                <td><span class="badge text-bg-info">@item.Seat.SeatNumber</span></td>
                                <td>@item.Movie.DateTime.ToString("dd MMM yyyy, hh:mm tt")</td>
                                <td>@item.Price.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</td>
                                <td>
                                    @if (item.Status == TicketStatus.Confirmed)
                                    {
                                        <span class="badge text-bg-success">Confirmed</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Canceled</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
