@model IEnumerable<Cart>

@{
    ViewData["Title"] = "My Cart";
}

<h4 class="mb-3">My Cart</h4>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <span class="fas fa-ticket-alt fs-1 text-muted mb-3 d-block"></span>
        <p class="text-muted">Your cart is empty.</p>
        <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-primary">Browse Movies</a>
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Movie</th>
                        <th>Seat</th>
                        <th>Showtime</th>
                        <th>Price</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Movie.Name</td>
                            <td><span class="badge text-bg-info">@item.Seat.SeatNumber</span></td>
                            <td>@item.Movie.DateTime.ToString("dd MMM, hh:mm tt")</td>
                            <td>@item.CurrentPrice.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</td>
                            <td class="text-end">
                                <a asp-action="RemoveSeat" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"><span class="fas fa-trash-alt"></span></a>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="3" class="text-end">Total</th>
                        <th colspan="2">@Model.Sum(e => e.CurrentPrice).ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</th>
                    </tr>
                </tfoot>
            </table>

            <div class="text-end">
                <a asp-action="PayCash" class="btn btn-outline-warning me-2">
                    <span class="fas fa-money-bill-wave me-1"></span> Pay with Cash
                </a>
                <a asp-action="Pay" class="btn btn-primary">
                    <span class="fas fa-lock me-1"></span> Pay Online
                </a>
            </div>
        </div>
    </div>
}

@section Notification {
    <partial name="_NotificationPartial" />
}
