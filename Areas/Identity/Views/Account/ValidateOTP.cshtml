@model ValidateOTPVM

@{
    ViewData["Title"] = "Validate OTP";
}

<h4 class="mb-3">Validate OTP</h4>
<p class="fs-10 text-muted">Check your email inbox and enter the 4-digit code we sent you.</p>

<form method="post">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="OTP" class="form-label"></label>
        <input asp-for="OTP" class="form-control text-center" maxlength="4" />
        <span asp-validation-for="OTP" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <button type="submit" class="btn btn-primary d-block w-100">Validate</button>
    </div>
</form>

<div class="text-center">
    <a asp-action="Login">Back to Login</a>
</div>

@section Notification {
    <partial name="_NotificationPartial" />
}
