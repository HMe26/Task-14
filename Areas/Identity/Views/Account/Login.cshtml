@model LoginVM

@{
    ViewData["Title"] = "Login";
}

<h4 class="mb-3">Login</h4>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="EmailOrUserName" class="form-label"></label>
        <input asp-for="EmailOrUserName" class="form-control" placeholder="Email or User Name" />
        <span asp-validation-for="EmailOrUserName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" placeholder="Password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="Remember" class="form-check-input" />
        <label asp-for="Remember" class="form-check-label"></label>
    </div>

    <div class="mb-3">
        <button type="submit" class="btn btn-primary d-block w-100">Login</button>
    </div>
</form>

<div class="text-center">
    <a asp-action="ForgetPassword" class="fs-10">Forget Password?</a>
</div>
<div class="text-center mt-1">
    <a asp-action="ResendConfirmation" class="fs-10">Didn't get the confirmation email?</a>
</div>
<div class="text-center mt-2">
    <a asp-action="Register">Don't have an account? Register</a>
</div>

@section Notification {
    <partial name="_NotificationPartial" />
}
